---
import Base from '../../layouts/Base.astro';
import { TOOLS, toolHref } from '../../tools';
---
<Base title="工具">
	<h1>工具</h1>
	<p class="lede">全部在浏览器本地运行,输入的内容不会上传。</p>
	<ul class="list">
		{TOOLS.map((t) => (
			<li>
				<a href={toolHref(t)}>
					<span class="kind">tool</span>
					<span><strong>{t.name}</strong><span class="desc">{t.desc}</span></span>
				</a>
			</li>
		))}
	</ul>
</Base>
